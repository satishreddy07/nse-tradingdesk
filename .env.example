# Server & Database Configuration
PORT=8000
HOST=0.0.0.0
DB_PATH=data/swing_trades.db

# Quant Engine Defaults
P1_BASE_CAPITAL=500000.0
P1_BASE_RISK_PCT=0.75
CHARTINK_URL=https://chartink.com/screener/testtttt-157
P2_BASE_CAPITAL=100000.0
P2_RISK_PER_TRADE=0.015
P2_MAX_SLOTS=10
P2_STOP_ATR_MULT=2.0

# Telegram Cloud Vault Sync & Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# AI Intelligence Layer (Groq + OpenRouter Free Tier)
# ==============================================================================
# Toggle AI layer on/off without affecting core deterministic ML predictions
AI_ENABLED=true

# Active Provider: "groq" or "openrouter"
AI_PROVIDER=groq

# Primary & Fallback Models (Must match IDs in ai_engine.model_registry)
AI_PRIMARY_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=openai/gpt-oss-20b

# Network Timeout & Retry Safeguards
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

# Groq Credentials & Base URL (Free Tier)
# Base URL: https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter Credentials & Base URL (Free Tier)
# Base URL: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
