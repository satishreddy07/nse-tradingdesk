# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment secrets
.env
*.env
.env.local

# Historical data cache (regenerated on fly)
data/historical_data/*.pkl
data/historical_data/*.csv

# SQLite WAL/SHM temporary files
data/*.db-wal
data/*.db-shm

# Model registry binary bundles (regenerated/trained online)
models/registry/*.bundle
!models/registry/.gitkeep


# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
